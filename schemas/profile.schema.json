{
  "$defs": {
    "AdaptivePpbConfig": {
      "additionalProperties": false,
      "description": "Per-candidate extraction routing based on pixels-per-bit (PPB).\n\nCandidates with `ppb < threshold` run `low_extraction` + `low_refinement`;\ncandidates with `ppb >= threshold` run `high_extraction` + `high_refinement`.\nAt `ppb == threshold` exactly the low route wins (deterministic tie-break\nfor snapshot stability).",
      "properties": {
        "high_extraction": {
          "enum": [
            "ContourRdp",
            "EdLines"
          ],
          "title": "High Extraction",
          "type": "string"
        },
        "high_refinement": {
          "enum": [
            "Erf",
            "None"
          ],
          "title": "High Refinement",
          "type": "string"
        },
        "low_extraction": {
          "enum": [
            "ContourRdp",
            "EdLines"
          ],
          "title": "Low Extraction",
          "type": "string"
        },
        "low_refinement": {
          "enum": [
            "Erf",
            "None"
          ],
          "title": "Low Refinement",
          "type": "string"
        },
        "threshold": {
          "default": 2.5,
          "exclusiveMaximum": 5.0,
          "exclusiveMinimum": 1.0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "title": "AdaptivePpbConfig",
      "type": "object"
    },
    "DecoderConfig": {
      "additionalProperties": false,
      "properties": {
        "corner_subpix": {
          "default": true,
          "title": "Corner Subpix",
          "type": "boolean"
        },
        "max_border_error_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Border Error Rate"
        },
        "max_hamming_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Hamming Error"
        },
        "min_contrast": {
          "default": 20.0,
          "minimum": 0.0,
          "title": "Min Contrast",
          "type": "number"
        },
        "refinement_mode": {
          "enum": [
            "Erf",
            "None"
          ],
          "title": "Refinement Mode",
          "type": "string"
        }
      },
      "title": "DecoderConfig",
      "type": "object"
    },
    "PoseConfig": {
      "additionalProperties": false,
      "properties": {
        "huber_delta_px": {
          "default": 1.5,
          "minimum": 0.0,
          "title": "Huber Delta Px",
          "type": "number"
        },
        "outlier_drop_d2_threshold": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Outlier Drop D2 Threshold",
          "type": "number"
        },
        "pose_consistency_fpr": {
          "default": 0.0,
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Pose Consistency Fpr",
          "type": "number"
        },
        "pose_consistency_gate_sigma_px": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Pose Consistency Gate Sigma Px",
          "type": "number"
        },
        "pose_edge_refinement_enabled": {
          "default": false,
          "title": "Pose Edge Refinement Enabled",
          "type": "boolean"
        },
        "sigma_n_sq": {
          "default": 4.0,
          "minimum": 0.0,
          "title": "Sigma N Sq",
          "type": "number"
        },
        "structure_tensor_radius": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Structure Tensor Radius",
          "type": "integer"
        },
        "tikhonov_alpha_max": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Tikhonov Alpha Max",
          "type": "number"
        }
      },
      "title": "PoseConfig",
      "type": "object"
    },
    "QuadConfig": {
      "additionalProperties": false,
      "properties": {
        "edlines_imbalance_gate": {
          "enum": [
            "Disabled",
            "Enabled"
          ],
          "title": "Edlines Imbalance Gate",
          "type": "string"
        },
        "extraction_mode": {
          "enum": [
            "ContourRdp",
            "EdLines"
          ],
          "title": "Extraction Mode",
          "type": "string"
        },
        "extraction_policy": {
          "anyOf": [
            {
              "const": "Static",
              "type": "string"
            },
            {
              "$ref": "#/$defs/_AdaptivePpbPolicy"
            }
          ],
          "default": "Static",
          "title": "Extraction Policy"
        },
        "max_aspect_ratio": {
          "default": 10.0,
          "minimum": 1.0,
          "title": "Max Aspect Ratio",
          "type": "number"
        },
        "max_elongation": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Max Elongation",
          "type": "number"
        },
        "max_fill_ratio": {
          "default": 0.98,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Max Fill Ratio",
          "type": "number"
        },
        "min_area": {
          "default": 36,
          "minimum": 1,
          "title": "Min Area",
          "type": "integer"
        },
        "min_density": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Density",
          "type": "number"
        },
        "min_edge_length": {
          "default": 4.0,
          "exclusiveMinimum": 0.0,
          "title": "Min Edge Length",
          "type": "number"
        },
        "min_edge_score": {
          "default": 4.0,
          "minimum": 0.0,
          "title": "Min Edge Score",
          "type": "number"
        },
        "min_fill_ratio": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Fill Ratio",
          "type": "number"
        },
        "subpixel_refinement_sigma": {
          "default": 0.6,
          "minimum": 0.0,
          "title": "Subpixel Refinement Sigma",
          "type": "number"
        },
        "upscale_factor": {
          "default": 1,
          "minimum": 1,
          "title": "Upscale Factor",
          "type": "integer"
        }
      },
      "title": "QuadConfig",
      "type": "object"
    },
    "SegmentationConfig": {
      "additionalProperties": false,
      "properties": {
        "connectivity": {
          "enum": [
            "Eight",
            "Four"
          ],
          "title": "Connectivity",
          "type": "string"
        }
      },
      "title": "SegmentationConfig",
      "type": "object"
    },
    "ThresholdConfig": {
      "additionalProperties": false,
      "properties": {
        "enable_sharpening": {
          "default": true,
          "title": "Enable Sharpening",
          "type": "boolean"
        },
        "local_mean_radius": {
          "default": 7,
          "maximum": 127,
          "minimum": 1,
          "title": "Local Mean Radius",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "LocalMean",
            "TileMidExtreme"
          ],
          "title": "Mode",
          "type": "string"
        },
        "noise_k": {
          "default": 4.0,
          "exclusiveMinimum": 0.0,
          "title": "Noise K",
          "type": "number"
        },
        "tile_size": {
          "default": 8,
          "maximum": 64,
          "minimum": 2,
          "title": "Tile Size",
          "type": "integer"
        }
      },
      "title": "ThresholdConfig",
      "type": "object"
    },
    "_AdaptivePpbPolicy": {
      "additionalProperties": false,
      "description": "Wrapper mirroring serde's externally-tagged `{\"AdaptivePpb\": {...}}` form.",
      "properties": {
        "AdaptivePpb": {
          "$ref": "#/$defs/AdaptivePpbConfig"
        }
      },
      "required": [
        "AdaptivePpb"
      ],
      "title": "_AdaptivePpbPolicy",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Nested detector configuration.\n\nThe three shipped profiles live in ``crates/locus-core/profiles/*.json``\nand are embedded into the Rust crate at compile time; the wheel reads\nthe exact same bytes through the FFI. Those JSON profiles are\nauthoritative. Load via :meth:`from_profile` for a shipped profile or\n:meth:`from_profile_json` for a user-supplied JSON string.",
  "properties": {
    "decoder": {
      "$ref": "#/$defs/DecoderConfig"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "pose": {
      "$ref": "#/$defs/PoseConfig"
    },
    "quad": {
      "$ref": "#/$defs/QuadConfig"
    },
    "segmentation": {
      "$ref": "#/$defs/SegmentationConfig"
    },
    "threshold": {
      "$ref": "#/$defs/ThresholdConfig"
    }
  },
  "title": "DetectorConfig",
  "type": "object"
}
