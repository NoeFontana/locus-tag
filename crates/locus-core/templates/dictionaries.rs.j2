{% for dict in dictionaries %}
pub(crate) const CODES_{{ dict.enum_name|upper }}: &[u64] = &[
    {% for code in dict.codes %}0x{{ "{:016X}"|format(code) }},
    {% endfor %}
];

pub(crate) const POINTS_{{ dict.enum_name|upper }}: &[(f64, f64)] = &[
    {% for p in dict.canonical_sampling_points %}({{ "{:.6}"|format(p[0]) }}, {{ "{:.6}"|format(p[1]) }}),
    {% endfor %}
];

pub(crate) const DICT_{{ dict.enum_name|upper }}: TagDictionary = TagDictionary {
    payload_length: {{ dict.payload_length }},
    dimension: {{ dict.dimension }},
    min_hamming: {{ dict.minimum_hamming_distance }},
    num_codes_per_rotation: {{ dict.dictionary_size }},
    codes: CODES_{{ dict.enum_name|upper }},
};
{% endfor %}

// Family mapping function match arm
{%- macro map_family(enum_name) -%}
    crate::config::TagFamily::{{ enum_name }} => &DICT_{{ enum_name|upper }},
{%- endmacro -%}
